<%- include('../partials/header', { title }) %>
<div class="page-head"><h1>Users</h1><a class="btn btn-primary" href="/admin/users/new">Add a user</a></div>
<div class="table-responsive">
<table class="work-table">
  <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Account</th><th></th></tr></thead>
  <tbody>
  <% users.forEach(u => { %>
    <tr>
      <td class="title"><%= u.name %></td>
      <td><%= u.email %></td>
      <td>
        <form method="post" action="/admin/users/<%= u.id %>/role" class="d-flex gap-1">
          <select name="role" class="form-select form-select-sm" aria-label="Role for <%= u.name %>" <%= u.id === user.id ? 'disabled' : '' %>>
            <% roles.forEach(r => { %><option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= r %></option><% }) %>
          </select>
          <% if (u.id !== user.id) { %><button class="btn btn-outline-primary btn-sm">Save</button><% } %>
        </form>
      </td>
      <td><span class="chip chip-<%= u.active ? 'completed' : 'cancelled' %>"><%= u.active ? 'Active' : 'Deactivated' %></span></td>
      <td>
        <% if (u.id !== user.id) { %>
        <form method="post" action="/admin/users/<%= u.id %>/toggle">
          <button class="btn btn-outline-<%= u.active ? 'danger' : 'success' %> btn-sm"><%= u.active ? 'Deactivate' : 'Reactivate' %></button>
        </form>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<%- include('../partials/footer') %>