<%- include('../partials/header', { title }) %>
<div class="page-head"><div><a class="back" href="/admin/users">Back to users</a><h1>Add a user</h1></div></div>
<div class="form-panel" style="max-width:560px">
  <form method="post" action="/admin/users" novalidate>
    <% [['name','Full name','text'],['email','Email','email'],['password','Temporary password (8+ characters, letters and numbers)','password']].forEach(f => { %>
    <div class="mb-3">
      <label for="<%= f[0] %>" class="form-label"><%= f[1] %></label>
      <input type="<%= f[2] %>" id="<%= f[0] %>" name="<%= f[0] %>" autocomplete="off" class="form-control <%= errors[f[0]] ? 'is-invalid' : '' %>"
        <% if (f[2] !== 'password') { %>value="<%= values[f[0]] || '' %>"<% } %>>
      <div class="invalid-feedback"><%= errors[f[0]] %></div>
    </div>
    <% }) %>
    <div class="mb-3">
      <label for="role" class="form-label">Role</label>
      <select id="role" name="role" class="form-select <%= errors.role ? 'is-invalid' : '' %>">
        <% roles.forEach(r => { %><option value="<%= r %>" <%= values.role === r ? 'selected' : '' %>><%= r %></option><% }) %>
      </select>
      <div class="invalid-feedback"><%= errors.role %></div>
    </div>
    <button class="btn btn-primary">Create user</button>
    <a class="btn btn-link" href="/admin/users">Cancel</a>
  </form>
</div>
<%- include('../partials/footer') %>