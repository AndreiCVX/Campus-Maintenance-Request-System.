<%- include('partials/header', { title }) %>
<div class="auth">
  <section class="auth-side">
    <div>
      <h1>Report it once. Watch it get fixed.</h1>
      <p>An account lets you submit problems, edit them while they are still pending, and see who is working on them.</p>
    </div>
    <div>
      <div class="ticket">
        <div class="t-title">Leaking faucet in restroom</div>
        <div class="t-meta">Library, first floor</div>
        <span class="chip chip-completed">Completed</span>
      </div>
      <div class="t-cap">Example request</div>
    </div>
  </section>
  <section class="auth-form">
    <div class="inner">
      <h2>Create account</h2>
      <p class="sub">Use your school email.</p>
      <form method="post" action="/register" novalidate>
        <% [['name','Full name','text','name'],['email','School email','email','username'],['password','Password (8+ characters, letters and numbers)','password','new-password'],['confirm','Confirm password','password','new-password']].forEach(f => { %>
        <div class="mb-3">
          <label for="<%= f[0] %>" class="form-label"><%= f[1] %></label>
          <input type="<%= f[2] %>" id="<%= f[0] %>" name="<%= f[0] %>" autocomplete="<%= f[3] %>" class="form-control <%= errors[f[0]] ? 'is-invalid' : '' %>"
            <% if (f[2] !== 'password') { %>value="<%= values[f[0]] || '' %>"<% } %>>
          <div class="invalid-feedback"><%= errors[f[0]] %></div>
        </div>
        <% }) %>
        <button class="btn btn-primary w-100">Create account</button>
      </form>
      <p class="mt-3 mb-0">Already registered? <a href="/login">Log in</a></p>
    </div>
  </section>
</div>
<%- include('partials/footer') %>