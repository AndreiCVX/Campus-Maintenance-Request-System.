<%- include('../partials/header', { title }) %>
<% const back = user.role === 'admin' ? ['/admin/requests', 'Back to all requests'] : user.role === 'maintenance' ? ['/tech/jobs', 'Back to my jobs'] : ['/requests', 'Back to my requests']; %>
<a class="back" href="<%= back[0] %>"><%= back[1] %></a>
<div class="page-head">
  <h1>#<%= r.id %> <%= r.title %></h1>
  <span class="chip chip-lg chip-<%= badge(r.status) %>"><%= r.status %></span>
</div>

<div class="detail-grid">
  <div>
    <section class="panel">
      <p class="mb-3"><%= r.description %></p>
      <dl class="facts">
        <dt>Category</dt><dd><%= cap(r.category) %></dd>
        <dt>Location</dt><dd><%= r.building %>, room <%= r.room %></dd>
        <dt>Urgency</dt><dd><%= cap(r.urgency) %></dd>
        <dt>Priority</dt><dd><%= r.priority ? cap(r.priority) : 'Not set yet' %></dd>
        <dt>Requested by</dt><dd><%= r.requester_name %></dd>
        <dt>Technician</dt><dd><%= r.tech_name || 'Not assigned yet' %></dd>
        <dt>Submitted</dt><dd><%= fmt(r.created_at) %></dd>
      </dl>
      <% if (user.role === 'requester' && r.status === 'Pending') { %>
        <div class="mt-3">
          <a class="btn btn-outline-primary btn-sm" href="/requests/<%= r.id %>/edit">Edit request</a>
          <form method="post" action="/requests/<%= r.id %>/cancel" class="d-inline" onsubmit="return confirm('Cancel this request?')">
            <button class="btn btn-outline-danger btn-sm">Cancel request</button>
          </form>
        </div>
      <% } %>
    </section>
  </div>

  <div>
    <% if (user.role === 'admin' && ['Pending','Assigned'].includes(r.status)) { %>
    <section class="panel action">
      <h2>Assign a technician</h2>
      <form method="post" action="/admin/requests/<%= r.id %>/assign">
        <label for="assigned_to" class="form-label">Technician</label>
        <select id="assigned_to" name="assigned_to" class="form-select mb-2" required>
          <option value="">Choose a technician</option>
          <% techs.forEach(t => { %><option value="<%= t.id %>" <%= r.assigned_to === t.id ? 'selected' : '' %>><%= t.name %></option><% }) %>
        </select>
        <label for="priority" class="form-label">Priority</label>
        <select id="priority" name="priority" class="form-select mb-3">
          <% levels.forEach(l => { %><option value="<%= l %>" <%= (r.priority || r.urgency) === l ? 'selected' : '' %>><%= cap(l) %></option><% }) %>
        </select>
        <button class="btn btn-primary btn-sm">Assign</button>
      </form>
    </section>
    <% } %>

    <% if (user.role === 'admin' && r.status === 'Completed') { %>
    <section class="panel action">
      <h2>Reopen this request</h2>
      <form method="post" action="/admin/requests/<%= r.id %>/reopen">
        <label for="reopen-note" class="form-label">Reason</label>
        <input id="reopen-note" name="note" class="form-control mb-3" maxlength="500" required>
        <button class="btn btn-warning btn-sm">Reopen</button>
      </form>
    </section>
    <% } %>

    <% if (user.role === 'maintenance' && r.assigned_to === user.id && ['Assigned','In Progress'].includes(r.status)) { %>
    <section class="panel action">
      <h2><%= r.status === 'Assigned' ? 'Start this job' : 'Finish this job' %></h2>
      <form method="post" action="/tech/jobs/<%= r.id %>/status">
        <input type="hidden" name="status" value="<%= r.status === 'Assigned' ? 'In Progress' : 'Completed' %>">
        <label for="note" class="form-label"><%= r.status === 'Assigned' ? 'What will you do first?' : 'What did you fix?' %></label>
        <textarea id="note" name="note" rows="3" maxlength="500" class="form-control mb-3" required></textarea>
        <button class="btn btn-primary btn-sm"><%= r.status === 'Assigned' ? 'Mark In Progress' : 'Mark Completed' %></button>
      </form>
    </section>
    <% } %>

    <section class="panel">
      <h2>History</h2>
      <ul class="timeline">
        <% history.slice().reverse().forEach(h => { %>
        <li>
          <div class="tl-status"><%= h.new_status %></div>
          <div class="tl-meta"><%= h.who %>, <%= fmt(h.created_at) %></div>
          <% if (h.note) { %><div class="tl-note"><%= h.note %></div><% } %>
        </li>
        <% }) %>
      </ul>
    </section>
  </div>
</div>
<%- include('../partials/footer') %>