<%- include('partials/header', { title }) %>
<div class="row justify-content-center"><div class="col-md-5">
  <h1 class="h3 mb-3">Log in</h1>
  <% if (formError) { %><div class="alert alert-danger"><%= formError %></div><% } %>
  <form method="post" action="/login" novalidate>
    <div class="mb-3">
      <label for="email" class="form-label">Email</label>
      <input type="email" id="email" name="email" class="form-control <%= errors.email ? 'is-invalid' : '' %>" value="<%= values.email || '' %>">
      <div class="invalid-feedback"><%= errors.email %></div>
    </div>
    <div class="mb-3">
      <label for="password" class="form-label">Password</label>
      <input type="password" id="password" name="password" class="form-control <%= errors.password ? 'is-invalid' : '' %>">
      <div class="invalid-feedback"><%= errors.password %></div>
    </div>
    <button class="btn btn-primary">Log in</button>
    <a class="ms-2" href="/register">Create an account</a>
  </form>
</div></div>
<%- include('partials/footer') %>
